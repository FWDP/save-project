# Backend URL reachable by the phone, for example http://192.168.1.25:3000.
EXPO_PUBLIC_API_URL=

# Public WalletConnect application identifier. Create one at https://dashboard.walletconnect.com/.
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional public HTTPS page that identifies SAVE Finance in Freighter.
# Until one is provided, the app uses https://github.com/FWDP/save-project.
EXPO_PUBLIC_WALLETCONNECT_METADATA_URL=
